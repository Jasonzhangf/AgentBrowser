{
  "$id": "https://appsdk.local/contracts/records/plan-revision-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "new_plan_hash": {
      "pattern": "^sha256:",
      "type": "string"
    },
    "previous_plan_hash": {
      "pattern": "^sha256:",
      "type": "string"
    },
    "reason": {
      "enum": [
        "new_evidence",
        "new_blocker",
        "hypothesis_rejected",
        "scope_changed",
        "owner_changed",
        "source_drift",
        "environment_changed",
        "prior_solution_matched",
        "rule_context_changed",
        "guidance_manifest_changed",
        "project_contract_changed",
        "gate_contract_changed",
        "dependency_input_changed"
      ]
    },
    "record_type": {
      "const": "PlanRevisionRecord"
    },
    "revision_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "revision_id",
    "task_id",
    "previous_plan_hash",
    "new_plan_hash",
    "reason",
    "created_at"
  ],
  "title": "AppSDK PlanRevisionRecord",
  "type": "object"
}

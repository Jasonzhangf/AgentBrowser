{
  "$id": "https://appsdk.local/contracts/records/promotion-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "architecture_review_id": {
      "type": "string"
    },
    "artifact_hash": {
      "type": "string"
    },
    "base_artifact_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_commit": {
      "type": "string"
    },
    "bug_closure_verified": {
      "type": "boolean"
    },
    "candidate_commit": {
      "type": "string"
    },
    "change_reason_comment": {
      "type": "string"
    },
    "change_set_id": {
      "type": "string"
    },
    "collaboration_record_id": {
      "type": "string"
    },
    "compatibility_level": {
      "enum": [
        "compatible",
        "migration_required",
        "breaking"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "design_id": {
      "type": "string"
    },
    "effectiveness_record_id": {
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "experiment_id": {
      "type": "string"
    },
    "fix_candidate_id": {
      "type": "string"
    },
    "integration_record_id": {
      "type": "string"
    },
    "issue_id": {
      "type": "string"
    },
    "mainline_receipt_record_id": {
      "type": "string"
    },
    "merge_queue_record_id": {
      "type": "string"
    },
    "merge_record_id": {
      "type": "string"
    },
    "merged_commit": {
      "type": "string"
    },
    "migration_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "module_id": {
      "type": "string"
    },
    "new_active_version": {
      "type": "string"
    },
    "playground_cleanup_record_id": {
      "type": "string"
    },
    "previous_active_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "promotion_id": {
      "type": "string"
    },
    "public_api_hash": {
      "type": "string"
    },
    "reproduction_record_id": {
      "type": "string"
    },
    "required_gate_results": {
      "items": {
        "properties": {
          "gate_id": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        },
        "required": [
          "gate_id",
          "result",
          "producer"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "review_id": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "scope_hash": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "worktree_record_id": {
      "type": "string"
    }
  },
  "required": [
    "promotion_id",
    "issue_id",
    "experiment_id",
    "module_id",
    "worktree_record_id",
    "reproduction_record_id",
    "fix_candidate_id",
    "architecture_review_id",
    "effectiveness_record_id",
    "merge_record_id",
    "base_commit",
    "candidate_commit",
    "merged_commit",
    "source_commit",
    "previous_active_version",
    "new_active_version",
    "review_id",
    "evidence_ids",
    "required_gate_results",
    "change_set_id",
    "compatibility_level",
    "root_cause",
    "design_id",
    "change_reason_comment",
    "playground_cleanup_record_id",
    "bug_closure_verified",
    "created_at"
  ],
  "type": "object"
}

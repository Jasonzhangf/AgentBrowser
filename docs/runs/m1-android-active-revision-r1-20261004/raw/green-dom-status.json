{"body":"<body data-remote=\"false\"><div id=\"root\"><div class=\"plugin-shell\"><div><main class=\"local-shell\" data-remote=\"false\" data-connection=\"local\" data-error=\"false\" data-drawer-open=\"false\" data-presentation=\"browsing\" data-visible-content=\"webview\" style=\"--safe-top: 24px; --safe-right: 0px; --safe-bottom: 24px; --safe-left: 0px;\"><header class=\"browser-chrome\" aria-label=\"浏览器工具栏\"><div class=\"chrome-nav\" role=\"group\" aria-label=\"页面导航\"><button id=\"back\" type=\"button\" aria-label=\"后退\" title=\"后退\" disabled=\"\">‹</button><button id=\"forward\" type=\"button\" aria-label=\"前进\" title=\"前进\" disabled=\"\">›</button><button id=\"reload\" type=\"button\" aria-label=\"刷新\" title=\"刷新\" disabled=\"\">↻</button></div><form class=\"browser-address\" novalidate=\"\"><label class=\"sr-only\" for=\"address\">页面地址</label><input id=\"address\" autocorrect=\"off\" spellcheck=\"false\" placeholder=\"输入页面地址\" disabled=\"\" type=\"url\" value=\"\"><span class=\"chrome-mode mode-local\" role=\"status\" aria-live=\"polite\">未连接</span></form><button id=\"tabs-toggle\" class=\"icon-button\" type=\"button\" aria-label=\"标签页\" title=\"标签页\" disabled=\"\"><span aria-hidden=\"true\">▤</span></button><button id=\"drawer-toggle\" class=\"icon-button\" type=\"button\" aria-controls=\"browser-drawer\" aria-expanded=\"false\" aria-label=\"打开菜单\" title=\"菜单\"><span aria-hidden=\"true\">☰</span></button></header><section class=\"viewer\" aria-label=\"原生视频区域\" data-ready=\"false\" data-visible-content=\"webview\" data-input-path=\"native-video-surface\"><div class=\"viewer-surface\"><div class=\"viewer-empty\"><strong>未连接 Host</strong><small>打开菜单配置连接</small></div></div></section><button class=\"drawer-backdrop\" type=\"button\" aria-label=\"关闭菜单\" aria-hidden=\"true\" tabindex=\"-1\"></button><aside id=\"browser-drawer\" class=\"drawer\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"drawer-title\" aria-hidden=\"true\" inert=\"\" data-open=\"false\"><
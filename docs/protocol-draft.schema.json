{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentBrowser v0 discussion-only control envelopes",
  "oneOf": [
    {"$ref": "#/$defs/operationRequest"},
    {"$ref": "#/$defs/takeoverRequest"},
    {"$ref": "#/$defs/operationResult"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "click": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "x", "y", "button"],
      "properties": {
        "kind": {"const": "click"},
        "x": {"type": "number", "minimum": 0, "maximum": 16384},
        "y": {"type": "number", "minimum": 0, "maximum": 16384},
        "button": {"enum": ["left", "middle", "right"]}
      }
    },
    "inputText": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"const": "input_text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "operationRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "type", "operationId", "hostIncarnation", "sessionId", "tabId", "attachmentId", "connectionGeneration", "controlEpoch", "documentRevision", "viewportRevision", "action"],
      "properties": {
        "version": {"const": 0}, "type": {"const": "operation.request"},
        "operationId": {"$ref": "#/$defs/id"}, "hostIncarnation": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"}, "tabId": {"$ref": "#/$defs/id"},
        "attachmentId": {"$ref": "#/$defs/id"}, "connectionGeneration": {"$ref": "#/$defs/id"},
        "controlEpoch": {"$ref": "#/$defs/revision"}, "documentRevision": {"$ref": "#/$defs/revision"},
        "viewportRevision": {"$ref": "#/$defs/revision"},
        "action": {"oneOf": [{"$ref": "#/$defs/click"}, {"$ref": "#/$defs/inputText"}]}
      }
    },
    "takeoverRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "type", "requestId", "hostIncarnation", "sessionId", "attachmentId", "connectionGeneration", "expectedControlEpoch"],
      "properties": {
        "version": {"const": 0}, "type": {"const": "control.request_takeover"},
        "requestId": {"$ref": "#/$defs/id"}, "hostIncarnation": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"}, "attachmentId": {"$ref": "#/$defs/id"},
        "connectionGeneration": {"$ref": "#/$defs/id"}, "expectedControlEpoch": {"$ref": "#/$defs/revision"}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": ["UNSUPPORTED_OPERATION", "STALE_CONTROL", "STALE_DOCUMENT", "STALE_VIEWPORT", "INPUT_FAILED", "EXECUTOR_LOST", "OPERATION_CONFLICT", "OUTCOME_UNKNOWN", "INVALID_ARGUMENT", "TAKEOVER_PENDING", "UNAUTHORIZED", "STALE_CONNECTION"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "operationResult": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "type", "operationId", "hostIncarnation", "sessionId", "status", "effects"],
      "properties": {
        "version": {"const": 0}, "type": {"const": "operation.result"},
        "operationId": {"$ref": "#/$defs/id"}, "hostIncarnation": {"$ref": "#/$defs/id"},
        "sessionId": {"$ref": "#/$defs/id"},
        "status": {"enum": ["rejected", "succeeded", "failed_stopped", "outcome_unknown"]},
        "effects": {"enum": ["none", "applied", "partial", "unknown"]},
        "error": {"$ref": "#/$defs/error"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"not": {"required": ["error"]}, "properties": {"effects": {"enum": ["none", "applied"]}}}, "else": {"required": ["error"]}},
        {"if": {"properties": {"status": {"const": "rejected"}}}, "then": {"properties": {"effects": {"const": "none"}}}},
        {"if": {"properties": {"status": {"const": "outcome_unknown"}}}, "then": {"properties": {"effects": {"const": "unknown"}}}}
      ]
    }
  }
}

{
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "generated/**",
      "protected/source/**"
    ]
  },
  "development_scenarios": {
    "enabled": [],
    "manifest": ".appsdk/contracts/development-scenarios.manifest.json"
  },
  "governance": {
    "active_kind": "immutable_consumable_library",
    "active_root": "active/lib/**",
    "debug_merge_comment_required": true,
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "generated_root": "generated/**",
    "playground_retention": "archive_then_remove",
    "playground_root": "playground/experiments/**",
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates"
    ],
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "protected_root": "protected/**",
    "record_contracts": [
      "contracts/records/worktree-record.schema.json",
      "contracts/records/reproduction-record.schema.json",
      "contracts/records/evidence-record.schema.json",
      "contracts/records/fix-candidate-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/effectiveness-record.schema.json",
      "contracts/records/pre-review-validation-record.schema.json",
      "contracts/records/collaboration-record.schema.json",
      "contracts/records/collaboration-index.schema.json",
      "contracts/records/merge-queue-record.schema.json",
      "contracts/records/merge-queue-state.schema.json",
      "contracts/records/integration-record.schema.json",
      "contracts/records/mainline-receipt-record.schema.json",
      "contracts/records/merge-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "runtime_forbidden_roots": [
      "playground/**",
      "generated/**"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json"
  },
  "guidance": {
    "compiled_manifest": ".appsdk/guidance/compiled.json",
    "enforcement": "advisory",
    "rule_sources": [
      {
        "kind": "agents",
        "path": "AGENTS.md",
        "precedence": 100,
        "required": false,
        "source_id": "project-agents"
      },
      {
        "contract_path": ".appsdk/skills/appsdk-project-governance/appsdk-guidance.json",
        "kind": "skill",
        "path": ".appsdk/skills/appsdk-project-governance/SKILL.md",
        "precedence": 200,
        "required": true,
        "source_id": "appsdk-governance-skill"
      }
    ]
  },
  "lifecycle": {
    "stage": "contract_bound"
  },
  "lifecycles": {
    "artifact": "generated",
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable"
  },
  "modules": [
    {
      "active_artifact": "active/lib/client-connection",
      "artifact_paths": [
        "libagentbrowser_connection.rlib",
        "connection-acceptance"
      ],
      "build": {
        "args": [
          "scripts/connection.py",
          "build"
        ],
        "program": "python3",
        "working_directory": "."
      },
      "contract_paths": [
        "docs/client-connection.md",
        "docs/architecture.md"
      ],
      "dependency_modules": [],
      "deployment_operations": [],
      "generated_outputs": [
        "target/**",
        "generated/modules/client-connection/**"
      ],
      "module_id": "client-connection",
      "owned_paths": [
        "packages/client-connection/**",
        "scripts/connection.py",
        "scripts/connection-admission.mjs",
        "Cargo.toml",
        "Cargo.lock"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "scripts/connection.py",
            "test"
          ],
          "program": "python3",
          "working_directory": "."
        },
        "input_paths": [
          "packages/client-connection/**",
          "scripts/connection.py",
          "scripts/connection-admission.mjs",
          "Cargo.toml",
          "Cargo.lock"
        ],
        "minimum_test_count": 6,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "connection-direct-wss"
      },
      "source_owner": "client-connection",
      "stage": "contract_bound"
    },
    {
      "active_artifact": "active/lib/android-probe",
      "artifact_paths": [
        "app-debug.apk"
      ],
      "build": {
        "args": [
          "run",
          "build:android"
        ],
        "program": "npm",
        "working_directory": "."
      },
      "contract_paths": [
        "docs/android-probe.md",
        "docs/android-annexb.md",
        "docs/android-network.md",
        "docs/architecture.md"
      ],
      "dependency_modules": [
        "client-connection"
      ],
      "deployment_operations": [
        "install",
        "restart"
      ],
      "generated_outputs": [
        "apps/android/app/build/**",
        "generated/modules/android-probe/**"
      ],
      "module_id": "android-probe",
      "owned_paths": [
        "apps/android/app/src/**",
        "apps/android/app/build.gradle",
        "apps/android/build.gradle",
        "apps/android/settings.gradle",
        "apps/android/gradle.properties",
        "apps/android/gradle/**",
        "apps/android/gradlew",
        "apps/android/gradlew.bat",
        "packages/ui-kernel/**",
        "packages/ui-plugins/**",
        "packages/client-domain/**",
        "packages/android-bridge/**",
        "scripts/build-native.py",
        "scripts/device-pairing.py",
        "scripts/network-replay.py",
        "scripts/validate-android.mjs",
        "scripts/android.sh",
        "scripts/build-android.sh",
        "scripts/build-ui.mjs",
        "scripts/device.sh",
        "package.json",
        "package-lock.json",
        "tsconfig.json"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "run",
            "verify:ci"
          ],
          "program": "npm",
          "working_directory": "."
        },
        "input_paths": [
          "packages/**",
          "apps/android/**",
          "scripts/**",
          "package.json",
          "package-lock.json",
          "tsconfig.json"
        ],
        "minimum_test_count": 8,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "android-cordis-h264"
      },
      "source_owner": "android-probe",
      "stage": "contract_bound"
    },
    {
      "active_artifact": "active/lib/macos-shell",
      "artifact_paths": [
        "AgentBrowserMac.app"
      ],
      "build": {
        "args": [
          "scripts/build-macos.sh",
          "build"
        ],
        "program": "bash",
        "working_directory": "."
      },
      "contract_paths": [
        "docs/macos-client.md",
        "docs/architecture.md"
      ],
      "dependency_modules": [
        "client-connection"
      ],
      "deployment_operations": [],
      "generated_outputs": [
        "apps/macos/build/**"
      ],
      "module_id": "macos-shell",
      "owned_paths": [
        "apps/macos/**",
        "scripts/build-macos.sh",
        "scripts/build-macos-ui.mjs",
        "docs/macos-client.md"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "scripts/build-macos.sh",
            "build"
          ],
          "program": "bash",
          "working_directory": "."
        },
        "input_paths": [
          "apps/macos/**",
          "scripts/build-macos.sh",
          "scripts/build-macos-ui.mjs",
          "docs/macos-client.md",
          "packages/client-connection/**",
          "packages/ui-kernel/**",
          "packages/ui-plugins/**",
          "packages/client-domain/**",
          "Cargo.toml",
          "Cargo.lock",
          "package-lock.json"
        ],
        "minimum_test_count": 1,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": false,
        "suite_id": "macos-native-h264"
      },
      "source_owner": "macos-shell",
      "stage": "contract_bound"
    }
  ],
  "project_id": "agentbrowser",
  "schema_version": 1,
  "sdk": {
    "bundle_manifest": ".appsdk/contracts/sdk-bundle.manifest.json",
    "name": "appsdk",
    "resource_record": ".appsdk/sdk-resources.json",
    "version": "0.1.6"
  }
}
